# MongoDB Atlas connection string (Atlas → Connect → Drivers → Python)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=emitc

# Auth — generate a long random string, e.g.  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Comma-separated frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
