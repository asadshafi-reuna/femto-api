# ---- database ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=femto

# ---- auth ----
JWT_SECRET=change-me-long-random
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=https://your-frontend.azurestaticapps.net

# ---- artifact storage (Azure Blob) ----
# Storage account -> Access keys -> Connection string
AZURE_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER=femto-artifacts
DOWNLOAD_URL_MINUTES=10

# ---- billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_SINGLE_UNLOCK_CENTS=900
PRICE_CREDIT_PACK_CENTS=4900
CREDIT_PACK_SIZE=10
CHECKOUT_SUCCESS_URL=https://your-frontend.azurestaticapps.net/#/dashboard
CHECKOUT_CANCEL_URL=https://your-frontend.azurestaticapps.net/#/dashboard

# ---- github oauth ----
# github.com -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://your-api.azurecontainerapps.io/github/callback
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
